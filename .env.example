# The public Google Spreadsheet ID (the long string in the sheet's URL).
# The sheet must be link-shareable ("anyone with the link can view") OR
# published to the web. The data is public by design.
NEXT_PUBLIC_SHEET_ID=1-FAKBI3xZjsrkrwXikwBW-9FHgGBjDyjMz-DTH8iRyA

# Worksheet (tab) names, in case you rename them in the sheet.
NEXT_PUBLIC_SLEEP_TAB=Sleep
NEXT_PUBLIC_LIFTS_TAB=Lifts
NEXT_PUBLIC_DANCE_TAB=Dance

# How often (seconds) the server re-fetches the sheet. Default 3600 (1 hour).
SHEET_REVALIDATE_SECONDS=3600

# =====================================================================
# PRIVATE METRICS (owner-only). All of the below are SERVER-ONLY secrets —
# set them in Vercel (Project → Settings → Environment Variables) and in a
# local .env.local. They are gitignored; never commit real values.
# Until these are set the site behaves exactly as before (public CSV reads,
# no private section).
# =====================================================================

# --- Service account: lets the server read the sheet once it's made PRIVATE ---
# Create a service account in Google Cloud, share the sheet with its email as
# Viewer, download its JSON key, and paste the ENTIRE key file here as one line
# (or base64-encode it if your UI mangles the newlines).
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@...iam.gserviceaccount.com",...}

# Worksheet (tab) holding the private metrics. Not a NEXT_PUBLIC var on purpose.
# PRIVATE_TAB=Private

# --- Sign in with Google: the owner-only gate for the private section ---
# AUTH_SECRET: random string — generate with `npx auth secret`.
# AUTH_SECRET=
# OAuth client (Web) credentials from Google Cloud → APIs & Services → Credentials.
# AUTH_GOOGLE_ID=xxxxx.apps.googleusercontent.com
# AUTH_GOOGLE_SECRET=
# The single Google account allowed to see the private section.
# ALLOWED_EMAIL=you@gmail.com
